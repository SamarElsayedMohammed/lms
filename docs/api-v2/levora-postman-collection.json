  "item": [
    {
      "name": "01. Multi-Auth Engine",
      "description": "Core identity gates supporting Students, Instructors, and Administrative Staff roles.",
      "item": [
        {
          "name": "Login - Email Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.status && res.data && res.data.token) {",
                  "        pm.environment.set(\"student_token\", res.data.token);",
                  "        console.log(\"Captured Student Sanctum Token successfully.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@levora.ai\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate standard user. Dynamic test script captures and updates the {{student_token}} variable on completion."
          },
          "response": []
        },
        {
          "name": "Register - Phone Number OTP Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Samar Mohammed\",\n  \"phone\": \"+201012345678\",\n  \"password\": \"SecuredPass@456\",\n  \"password_confirmation\": \"SecuredPass@456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register-phone",
              "host": ["{{base_url}}"],
              "path": ["auth", "register-phone"]
            },
            "description": "Register user with phone numbers, triggering mobile validation flow."
          },
          "response": []
        }
      ]
    },
