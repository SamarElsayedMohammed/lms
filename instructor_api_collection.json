{
	"info": {
		"_postman_id": "lms-instructor-complete-collection",
		"name": "LMS - Complete Instructor APIs",
		"description": "Comprehensive collection covering Public Join Requests, Instructor Panel Management, and Admin Oversight.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Public APIs",
			"description": "APIs accessible by guests or users wanting to become instructors.",
			"item": [
				{
					"name": "Submit Join Request (Become Instructor)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "name", "value": "John Doe", "type": "text" },
								{ "key": "email", "value": "john.doe@example.com", "type": "text" },
								{ "key": "phone", "value": "+1234567890", "type": "text" },
								{ "key": "specialty", "value": "Web Development", "type": "text" },
								{ "key": "experience_bio", "value": "I have 5 years of experience in React and Laravel.", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/api/become-instructor",
							"host": ["{{base_url}}"],
							"path": ["api", "become-instructor"]
						}
					}
				},
				{
					"name": "List All Instructors",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/get-instructors",
							"host": ["{{base_url}}"],
							"path": ["api", "get-instructors"]
						}
					}
				},
				{
					"name": "Get Instructor Details",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/get-instructor-details?id=1&slug=john-doe",
							"host": ["{{base_url}}"],
							"path": ["api", "get-instructor-details"],
							"query": [
								{ "key": "id", "value": "1" },
								{ "key": "slug", "value": "john-doe" }
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Instructor Panel (Authenticated)",
			"description": "APIs used by registered instructors to manage their earnings, profile, and dashboard.",
			"item": [
				{
					"name": "Get Instructor Dashboard",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{instructor_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/get-instructor-dashboard",
							"host": ["{{base_url}}"],
							"path": ["api", "get-instructor-dashboard"]
						}
					}
				},
				{
					"name": "Update Instructor Details",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{instructor_token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "experience", "value": "Updated bio and updated experience.", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/api/instructor/update-details",
							"host": ["{{base_url}}"],
							"path": ["api", "instructor", "update-details"]
						}
					}
				},
				{
					"name": "Earnings & Sales Stats",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{instructor_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/instructor/earnings",
							"host": ["{{base_url}}"],
							"path": ["api", "instructor", "earnings"]
						}
					}
				},
				{
					"name": "Request Withdrawal",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{instructor_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 500,\n    \"payment_method\": \"paypal\",\n    \"payment_details\": \"paypal@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/instructor/request-withdrawal",
							"host": ["{{base_url}}"],
							"path": ["api", "instructor", "request-withdrawal"]
						}
					}
				},
				{
					"name": "Withdrawal History",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{instructor_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/instructor/withdrawal-history",
							"host": ["{{base_url}}"],
							"path": ["api", "instructor", "withdrawal-history"]
						}
					}
				},
				{
					"name": "Wallet Details",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{instructor_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/instructor/wallet-details",
							"host": ["{{base_url}}"],
							"path": ["api", "instructor", "wallet-details"]
						}
					}
				}
			]
		},
		{
			"name": "3. Admin Panel (Authenticated)",
			"description": "APIs used by Administrators to manage instructors and their join requests.",
			"item": [
				{
					"name": "Instructor Requests Tracking",
					"item": [
						{
							"name": "List All Requests",
							"request": {
								"method": "GET",
								"header": [
									{ "key": "Accept", "value": "application/json" },
									{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
								],
								"url": {
									"raw": "{{base_url}}/api/admin/instructor-requests?status=pending&search=John",
									"host": ["{{base_url}}"],
									"path": ["api", "admin", "instructor-requests"],
									"query": [
										{ "key": "status", "value": "pending" },
										{ "key": "search", "value": "John" }
									]
								}
							}
						},
						{
							"name": "Update Request Status",
							"request": {
								"method": "PUT",
								"header": [
									{ "key": "Accept", "value": "application/json" },
									{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"status\": \"contacted\"\n}"
								},
								"url": {
									"raw": "{{base_url}}/api/admin/instructor-requests/1/status",
									"host": ["{{base_url}}"],
									"path": ["api", "admin", "instructor-requests", "1", "status"]
								}
							}
						},
						{
							"name": "Delete Request",
							"request": {
								"method": "DELETE",
								"header": [
									{ "key": "Accept", "value": "application/json" },
									{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
								],
								"url": {
									"raw": "{{base_url}}/api/admin/instructor-requests/1",
									"host": ["{{base_url}}"],
									"path": ["api", "admin", "instructor-requests", "1"]
								}
							}
						}
					]
				},
				{
					"name": "Instructor Management (CRUD)",
					"item": [
						{
							"name": "List Approved Instructors",
							"request": {
								"method": "GET",
								"header": [
									{ "key": "Accept", "value": "application/json" },
									{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
								],
								"url": {
									"raw": "{{base_url}}/api/admin/instructors",
									"host": ["{{base_url}}"],
									"path": ["api", "admin", "instructors"]
								}
							}
						},
						{
							"name": "Register New Instructor",
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Accept", "value": "application/json" },
									{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"Jane Smith\",\n    \"email\": \"jane.smith@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"phone\": \"0987654321\"\n}"
								},
								"url": {
									"raw": "{{base_url}}/api/admin/instructors",
									"host": ["{{base_url}}"],
									"path": ["api", "admin", "instructors"]
								}
							}
						},
						{
							"name": "Approve Instructor",
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Accept", "value": "application/json" },
									{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
								],
								"url": {
									"raw": "{{base_url}}/api/admin/instructors/1/approve",
									"host": ["{{base_url}}"],
									"path": ["api", "admin", "instructors", "1", "approve"]
								}
							}
						},
						{
							"name": "Suspend Instructor",
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Accept", "value": "application/json" },
									{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
								],
								"url": {
									"raw": "{{base_url}}/api/admin/instructors/1/suspend",
									"host": ["{{base_url}}"],
									"path": ["api", "admin", "instructors", "1", "suspend"]
								}
							}
						}
					]
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://your-domain.com", "type": "string" },
		{ "key": "instructor_token", "value": "insert_instructor_token_here", "type": "string" },
		{ "key": "admin_token", "value": "insert_admin_token_here", "type": "string" }
	]
}
