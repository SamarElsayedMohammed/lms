# Local Development Database Overrides
# ----------------------------------------------------
# When running PHP / Laravel Artisan commands locally on your host OS
# (outside the Docker container network), copy these overrides into your
# .env file or run with environment overrides:
#
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#
# Inside Docker containers (docker-compose), the database host is:
#   DB_HOST=db
# ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
