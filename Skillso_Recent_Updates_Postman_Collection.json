{
    "info": {
        "name": "Skillso LMS - Recent Updates (Auth, Security, Tracking, Chatbot, Certificates)",
        "description": "Collection containing all endpoints discussed recently including Certificates, Account Security, Multiple Auth Systems (Google, Mobile, Firebase), Tracking, and Chatbot functionalities.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Certificates (الشهادات)",
            "item": [
                {
                    "name": "Download Course Certificate",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"course_id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/certificate/course/download",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "certificate",
                                "course",
                                "download"
                            ]
                        }
                    }
                },
                {
                    "name": "Verify Certificate (Public)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/certificate/verify?certificate_id=CERT_12345",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "certificate",
                                "verify"
                            ],
                            "query": [
                                {
                                    "key": "certificate_id",
                                    "value": "CERT_12345"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
