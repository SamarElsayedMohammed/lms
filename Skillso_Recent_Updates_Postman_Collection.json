                {
                    "name": "Admin Update Course (Set Chatbot Settings)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"كورس البرمجة المتقدم\",\n  \"category_id\": 1,\n  \"chatbot_enabled\": 1,\n  \"chatbot_name\": \"مساعد كورس البرمجة\",\n  \"chatbot_welcome_message\": \"أهلاً بك، اسألني أي شيء في المنهج\",\n  \"chatbot_system_prompt\": \"أنت مساعد ذكي لكورس البرمجة. أجب باختصار شديد ولا تجب على أي أسئلة خارج نطاق المنهج المعطى لك.\",\n  \"ai_knowledge_content\": \"هنا يتم كتابة كل المعلومات والمادة العلمية...\",\n  \"chatbot_max_tokens\": 500\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/admin/courses/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "admin",
                                "courses",
                                "1"
                            ]
                        }
                    }
