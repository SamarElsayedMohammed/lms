{
  "info": {
    "name": "Skillso — Courses & Tracking",
    "description": "Postman collection for course browsing, student progress tracking (video/curriculum/quiz), and admin course-tracking dashboards.\n\nVariables:\n- base_url: Laravel API root (e.g. https://your-backend.com)\n- user_token: Student Bearer token (Sanctum)\n- admin_token: Admin Bearer token (Sanctum)\n- course_id, chapter_id, lecture_id, user_id: IDs for path/query params",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://toogowgo4ckks8cok84o4c4w.187.77.77.216.sslip.io" },
    { "key": "user_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "course_id", "value": "1" },
    { "key": "chapter_id", "value": "1" },
    { "key": "lecture_id", "value": "1" },
    { "key": "user_id", "value": "1" },
    { "key": "quiz_id", "value": "1" },
    { "key": "attempt_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Public — Courses",
      "description": "Browse courses without login (OptionalAuth — token optional).",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/get-courses?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "get-courses"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "category_id", "value": "", "disabled": true },
                { "key": "level", "value": "", "disabled": true }
              ]
            },
            "description": "GET /api/get-courses — paginated course catalog."
          }
        },
        {
          "name": "Get Course Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/get-course?course_id={{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "get-course"],
              "query": [{ "key": "course_id", "value": "{{course_id}}" }]
            },
            "description": "GET /api/get-course?course_id= — single course with full details."
          }
        },
        {
          "name": "Get Course Chapters",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/get-course-chapters?course_id={{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "get-course-chapters"],
              "query": [{ "key": "course_id", "value": "{{course_id}}" }]
            },
            "description": "GET /api/get-course-chapters?course_id= — curriculum structure (chapters, lectures, quizzes…)."
          }
        },
        {
          "name": "Get Course Reviews",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/get-course-reviews?course_id={{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "get-course-reviews"],
              "query": [{ "key": "course_id", "value": "{{course_id}}" }]
            }
          }
        },
        {
          "name": "Get Course FAQs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}/faqs",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", "{{course_id}}", "faqs"]
            }
          }
        }
      ]
    },
    {
