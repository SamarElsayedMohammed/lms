        {
          "name": "Mark Curriculum Item Completed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_chapter_id\": {{chapter_id}},\n  \"model_id\": {{lecture_id}},\n  \"model_type\": \"lecture\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/curriculum/mark-completed",
              "host": ["{{base_url}}"],
              "path": ["api", "curriculum", "mark-completed"]
            },
            "description": "POST /api/curriculum/mark-completed — model_type: lecture | quiz | assignment | document"
          }
        },
        {
          "name": "Get Detailed Curriculum Tracking",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/curriculum/detailed-tracking?course_id={{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "curriculum", "detailed-tracking"],
              "query": [
                { "key": "course_id", "value": "{{course_id}}" },
                { "key": "course_chapter_id", "value": "{{chapter_id}}", "disabled": true },
                { "key": "model_type", "value": "lecture", "disabled": true },
                { "key": "status", "value": "completed", "disabled": true }
              ]
            },
            "description": "GET /api/curriculum/detailed-tracking — all tracked items grouped by chapter."
          }
        },
        {
          "name": "Get Current (Last Completed) Curriculum",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/curriculum/current",
              "host": ["{{base_url}}"],
              "path": ["api", "curriculum", "current"]
            },
            "description": "GET /api/curriculum/current — resume point (last completed item)."
          }
        },
        {
          "name": "Check Course Completion (Certificate Eligibility)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/curriculum/course-completion?course_id={{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "curriculum", "course-completion"],
              "query": [{ "key": "course_id", "value": "{{course_id}}" }]
            },
            "description": "GET /api/curriculum/course-completion?course_id="
          }
