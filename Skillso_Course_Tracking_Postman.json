    {
      "name": "3. Student — Video Progress",
      "description": "Segment-based video tracking (100% watch rule). See docs/frontend-video-progress-integration.md",
      "item": [
        {
          "name": "Get Video Stream Token",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/video/{{lecture_id}}/stream",
              "host": ["{{base_url}}"],
              "path": ["api", "video", "{{lecture_id}}", "stream"]
            },
            "description": "GET /api/video/{lectureId}/stream — HLS stream UUID token (throttled 10/min)."
          }
        },
        {
          "name": "Get Lecture Video Progress",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/lecture/{{lecture_id}}/progress",
              "host": ["{{base_url}}"],
              "path": ["api", "lecture", "{{lecture_id}}", "progress"]
            },
            "description": "GET /api/lecture/{lectureId}/progress — watch_percentage, segments, resume_from, can_seek_to."
          }
        },
        {
          "name": "Update Lecture Video Progress (Segments)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_position\": 127,\n  \"total_duration\": 300,\n  \"newly_watched_segments\": [25, 26, 27]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/lecture/{{lecture_id}}/progress",
              "host": ["{{base_url}}"],
              "path": ["api", "lecture", "{{lecture_id}}", "progress"]
            },
            "description": "POST /api/lecture/{lectureId}/progress — send every ~15s. Max 3 segments per request."
          }
        },
        {
          "name": "Get Course Video Progress (All Lectures)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/course/{{course_id}}/progress",
              "host": ["{{base_url}}"],
              "path": ["api", "course", "{{course_id}}", "progress"]
            },
            "description": "GET /api/course/{courseId}/progress — aggregated video progress for all lectures in course."
          }
        }
      ]
    },
    {
      "name": "4. Student — Curriculum Tracking",
      "description": "Track course/chapter/item completion. Data feeds admin dashboards via user_curriculum_trackings + user_course_progress.",
      "item": [
        {
          "name": "Start / Update Course Tracking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": {{course_id}},\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/track/course",
              "host": ["{{base_url}}"],
              "path": ["api", "track", "course"]
            },
            "description": "POST /api/track/course — status: started | in_progress | completed"
          }
        },
        {
          "name": "Track Chapter Progress",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_chapter_id\": {{chapter_id}},\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/track/course-chapter",
              "host": ["{{base_url}}"],
              "path": ["api", "track", "course-chapter"]
