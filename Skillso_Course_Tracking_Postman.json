              "query": [{ "key": "course_id", "value": "{{course_id}}" }]
            },
            "description": "GET /api/curriculum/progress?course_id= — chapter-level progress."
          }
        },
        {
          "name": "Get Chapter Curriculum Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/curriculum/chapter-details?course_chapter_id={{chapter_id}}",
