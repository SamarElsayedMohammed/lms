# Laravel Telescope Configuration
# Add these lines to your .env file after installing telescope

# Enable/Disable Telescope
TELESCOPE_ENABLED=true

# URL path (default: telescope)
TELESCOPE_PATH=telescope

# Storage driver (database or redis)
TELESCOPE_DRIVER=database

# Allowed admin emails (comma separated)
TELESCOPE_ALLOWED_EMAILS=admin@example.com,support@yourdomain.com

# Allowed admin user IDs (comma separated)
TELESCOPE_ALLOWED_IDS=1,2

# Limit entries per page
TELESCOPE_LIMIT=100

# Night mode (dark theme)
# TELESCOPE_NIGHT_MODE=true
