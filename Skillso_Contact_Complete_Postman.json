{
  "info": {
    "_postman_id": "skillso-contact-complete",
    "name": "Skillso — Contact (User & Admin)",
    "description": "Postman collection for Skillso Contact / Support Center APIs.\n\nStructure:\n- **USER** — public submit + authenticated conversations & support notifications\n- **ADMIN** — contact messages management (list, thread, reply, status)\n\n## Variables\n- `base_url` — Laravel API root\n- `user_token` — student/user Bearer token\n- `admin_token` — admin Bearer token\n- `contact_message_id` — contact message / conversation ID\n- `notification_id` — support notification ID",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://toogowgo4ckks8cok84o4c4w.187.77.77.216.sslip.io" },
    { "key": "user_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "contact_message_id", "value": "1" },
    { "key": "notification_id", "value": "1" }
  ],
  "item": [
    {
      "name": "USER — Contact & Support",
      "description": "All user-facing contact endpoints.\n\nFlow:\n1. Submit form (guest or logged-in) → POST /api/contact-us\n2. List my conversations → GET /api/my-contact-messages\n3. Open thread → GET /api/my-contact-messages/{id}\n4. Reply → POST /api/my-contact-messages/{id}/reply\n5. Support notifications → GET /api/support-notifications",
      "item": [
        {
          "name": "Auth — User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token || json?.data?.access_token;",
                  "if (token) pm.collectionVariables.set('user_token', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user-login",
              "host": ["{{base_url}}"],
              "path": ["api", "user-login"]
            },
            "description": "POST /api/user-login — saves token to {{user_token}}."
          }
        },
        {
          "name": "Submit Contact Form (Public — Guest OK)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ahmed\",\n  \"email\": \"ahmed@example.com\",\n  \"message\": \"I need help with my subscription. Can you assist?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/contact-us",
              "host": ["{{base_url}}"],
              "path": ["api", "contact-us"]
            },
            "description": "POST /api/contact-us — **No auth required**.\n\nGuest or logged-in user can submit.\nIf Bearer token is sent, `user_id` is linked automatically.\n\nRequired fields:\n- first_name (string, max 255)\n- email (email)\n- message (string, max 2000)\n\nStatus after submit: `new`"
          }
        },
        {
          "name": "Submit Contact Form (Authenticated User)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ahmed\",\n  \"email\": \"student@example.com\",\n  \"message\": \"Follow-up on my previous inquiry about course access.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/contact-us",
              "host": ["{{base_url}}"],
              "path": ["api", "contact-us"]
            },
            "description": "Same endpoint with Bearer token — message linked to user account for Support Center."
          }
        },
        {
          "name": "List My Contact Messages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/my-contact-messages?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "my-contact-messages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "GET /api/my-contact-messages — **Auth required**.\n\nReturns user's conversations with:\n- id, subject, status, unread_count, created_at, last_reply_at\n\nStatus values: new | waiting_admin | replied | closed | completed | reopened"
          }
        },
        {
          "name": "Get Contact Message Thread",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/my-contact-messages/{{contact_message_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "my-contact-messages", "{{contact_message_id}}"]
            },
            "description": "GET /api/my-contact-messages/{id} — **Auth required**.\n\nReturns full conversation thread.\nAuto-marks admin replies as read.\n\nResponse:\n```json\n{\n  \"success\": true,\n  \"data\": {\n    \"id\": 1,\n    \"subject\": \"...\",\n    \"status\": \"replied\",\n    \"conversation\": [\n      { \"id\": 0, \"sender\": \"user\", \"message\": \"...\", \"created_at\": \"...\" },\n      { \"id\": 1, \"sender\": \"admin\", \"message\": \"...\", \"created_at\": \"...\" }\n    ]\n  }\n}\n```"
          }
        },
        {
          "name": "Reply to Contact Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Thank you, here is more information about my issue.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/my-contact-messages/{{contact_message_id}}/reply",
              "host": ["{{base_url}}"],
              "path": ["api", "my-contact-messages", "{{contact_message_id}}", "reply"]
            },
            "description": "POST /api/my-contact-messages/{id}/reply — **Auth required**.\n\nRequired: message (string, min 2 chars)\n\nCannot reply if status is `closed` or `completed`.\nSets status to `waiting_admin` after user reply."
          }
        },
        {
          "name": "Get Support Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/support-notifications?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "support-notifications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "GET /api/support-notifications — in-app notifications (e.g. admin replied to your message).\n\nType example: `support_reply`"
          }
        },
        {
          "name": "Get Support Notifications Unread Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/support-notifications/unread-count",
              "host": ["{{base_url}}"],
              "path": ["api", "support-notifications", "unread-count"]
            },
            "description": "GET /api/support-notifications/unread-count\n\nResponse: `{ \"success\": true, \"data\": { \"unread_count\": 3 } }`"
          }
        },
        {
          "name": "Mark Support Notification Read",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/support-notifications/{{notification_id}}/read",
              "host": ["{{base_url}}"],
              "path": ["api", "support-notifications", "{{notification_id}}", "read"]
            },
            "description": "POST /api/support-notifications/{id}/read"
          }
        },
        {
          "name": "Mark All Support Notifications Read",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/support-notifications/read-all",
              "host": ["{{base_url}}"],
              "path": ["api", "support-notifications", "read-all"]
            },
            "description": "POST /api/support-notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "ADMIN — Contact Messages",
      "description": "All admin contact management endpoints.\n\nRequires: Bearer {{admin_token}} + permission `contact-messages-list` / `contact-messages-edit`\n\nFlow:\n1. List messages → GET /api/admin/contact-messages\n2. View details → GET /api/admin/contact-messages/{id}\n3. View thread → GET /api/admin/contact-messages/{id}/thread\n4. Mark read → PUT /api/admin/contact-messages/{id}/read\n5. Update status → PUT /api/admin/contact-messages/{id}/status\n6. Reply → POST /api/admin/contact-messages/{id}/reply",
      "item": [
        {
          "name": "Auth — Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token || json?.data?.access_token;",
                  "if (token) pm.collectionVariables.set('admin_token', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin-login",
              "host": ["{{base_url}}"],
              "path": ["api", "admin-login"]
            },
            "description": "POST /api/admin-login — saves token to {{admin_token}}."
          }
        },
        {
          "name": "List Contact Messages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" },
                { "key": "search", "value": "", "description": "Search first_name, email, message", "disabled": true },
                { "key": "status", "value": "new", "description": "new | read | replied | closed | waiting_admin | completed | reopened", "disabled": true }
              ]
            },
            "description": "GET /api/admin/contact-messages\n\nPermission: contact-messages-list\n\nResponse includes:\n- messages (paginated)\n- new_count (unread new messages count)"
          }
        },
        {
          "name": "Get Contact Message Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages/{{contact_message_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages", "{{contact_message_id}}"]
            },
            "description": "GET /api/admin/contact-messages/{id}\n\nPermission: contact-messages-list\n\nReturns full message record (first_name, email, message, status, ip_address, user_id, etc.)"
          }
        },
        {
          "name": "Get Contact Message Thread",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages/{{contact_message_id}}/thread",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages", "{{contact_message_id}}", "thread"]
            },
            "description": "GET /api/admin/contact-messages/{id}/thread\n\nPermission: contact-messages-list\n\nReturns conversation array (user + admin messages chronologically)."
          }
        },
        {
          "name": "Mark Contact Message as Read",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages/{{contact_message_id}}/read",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages", "{{contact_message_id}}", "read"]
            },
            "description": "PUT /api/admin/contact-messages/{id}/read\n\nPermission: contact-messages-list\n\nTransitions status: new → read (admin viewed, not yet replied)."
          }
        },
        {
          "name": "Update Contact Message Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"closed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages/{{contact_message_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages", "{{contact_message_id}}", "status"]
            },
            "description": "PUT /api/admin/contact-messages/{id}/status\n\nPermission: contact-messages-list\n\nAllowed status (validation): new | read | replied | closed\n\nNote: DB also supports waiting_admin, completed, reopened (set by system on user reply)."
          }
        },
        {
          "name": "Update Status — Replied",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"replied\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages/{{contact_message_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages", "{{contact_message_id}}", "status"]
            }
          }
        },
        {
          "name": "Reply to Contact Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello Ahmed, thank you for contacting us. We have reviewed your inquiry and here is our response...\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages/{{contact_message_id}}/reply",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages", "{{contact_message_id}}", "reply"]
            },
            "description": "POST /api/admin/contact-messages/{id}/reply\n\nPermission: contact-messages-edit\n\nRequired: message (string, min 2)\nLegacy fallback field: reply_message\n\nActions on reply:\n1. Saves to contact_message_replies\n2. Sends email to user\n3. Sends in-app + FCM notification (if user_id exists)\n4. Sets status to `replied`"
          }
        },
        {
          "name": "Reply (Legacy Field reply_message)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reply_message\": \"Legacy reply field — still supported as fallback.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages/{{contact_message_id}}/reply",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages", "{{contact_message_id}}", "reply"]
            },
            "description": "Backward-compatible reply using `reply_message` instead of `message`."
          }
        },
        {
          "name": "Filter — New Messages Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages?status=new&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages"],
              "query": [
                { "key": "status", "value": "new" },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "Filter unhandled new contact messages."
          }
        },
        {
          "name": "Filter — Waiting Admin",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages?status=waiting_admin&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages"],
              "query": [
                { "key": "status", "value": "waiting_admin" },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "Messages where user replied and waiting for admin response."
          }
        },
        {
          "name": "Search Contact Messages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/contact-messages?search=ahmed@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "contact-messages"],
              "query": [{ "key": "search", "value": "ahmed@example.com" }]
            },
            "description": "Search by first_name, email, or message content."
          }
        }
      ]
    }
  ]
}
