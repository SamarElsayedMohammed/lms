{
  "info": {
    "name": "Skillso Subscription Modifications",
    "description": "Collection covering the recently updated subscription APIs including pricing security, checkout, new country pricing structure, and the comprehensive admin subscriptions dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Frontend APIs (User Facing)",
      "item": [
        {
          "name": "Get Subscription Plans (Secure)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Skillso-Resolved-Country",
                "value": "SA",
                "description": "Proxy resolved country code (ISO2)"
              },
              {
                "key": "X-Skillso-Country-Timestamp",
                "value": "{{$timestamp}}",
                "description": "Unix timestamp of the request"
              },
              {
                "key": "X-Skillso-Country-Signature",
                "value": "generate_hmac_sha256_here",
                "description": "HMAC signature using app.proxy_secret"
              },
              {
                "key": "CF-IPCountry",
                "value": "SA",
                "description": "Cloudflare header (will only be accepted if request originates from trusted Cloudflare IPs)",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/subscription/plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "subscription",
                "plans"
              ]
            },
            "description": "Retrieves plans. The pricing returned is dynamically resolved based on the secure proxy headers. Returns a deterministic format including price_source and can_subscribe fields."
          },
          "response": []
        },
        {
          "name": "Checkout / Subscribe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Skillso-Resolved-Country",
                "value": "SA"
              },
              {
                "key": "X-Skillso-Country-Timestamp",
                "value": "{{$timestamp}}"
              },
              {
                "key": "X-Skillso-Country-Signature",
                "value": "generate_hmac_sha256_here"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_id\": 1,\n  \"payment_method\": \"kashier\",\n  \"use_wallet\": false,\n  \"promo_code\": \"NEWUSER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/subscription/subscribe",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "subscription",
                "subscribe"
              ]
            },
            "description": "Initiates checkout. The server securely recalculates the exact pricing based on the authenticated country headers to prevent tampering. Promo codes are also checked for country/currency compatibility."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin APIs",
      "item": [
        {
          "name": "Comprehensive Subscriptions Dashboard (NEW)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/subscriptions?per_page=15&status=active&payment_method=manual",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "subscriptions"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "e.g. active, pending, cancelled"
                },
                {
                  "key": "payment_method",
                  "value": "manual",
                  "description": "Send 'manual' for manual subscriptions, or 'auto' for gateway subscriptions."
                },
                {
                  "key": "search",
                  "value": "ahmed",
                  "description": "Search by user name or email",
                  "disabled": true
                }
              ]
            },
            "description": "Returns comprehensive statistics (total revenue, active subscriptions count, split between manual and auto) along with a paginated list of all subscriptions."
          },
          "response": []
        },
        {
          "name": "Create Subscription Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": {\n    \"en\": \"Premium Plan\",\n    \"ar\": \"الخطة المميزة\"\n  },\n  \"description\": {\n    \"en\": \"Access to all courses\",\n    \"ar\": \"الوصول لكل الكورسات\"\n  },\n  \"interval\": \"month\",\n  \"interval_count\": 1,\n  \"price\": 1000,\n  \"is_active\": true,\n  \"country_prices\": [\n    {\n      \"country_code\": \"SA\",\n      \"price\": 150,\n      \"old_price\": 200,\n      \"currency_code\": \"SAR\",\n      \"is_active\": true\n    },\n    {\n      \"country_code\": \"AE\",\n      \"price\": 200,\n      \"old_price\": null,\n      \"currency_code\": \"AED\",\n      \"is_active\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/subscription-plan",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "subscription-plan"
              ]
            },
            "description": "Creates a new subscription plan. Modified to accept the new `country_prices` array format instead of numeric country IDs."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "user_token",
      "value": "put_user_bearer_token_here"
    },
    {
      "key": "admin_token",
      "value": "put_admin_bearer_token_here"
    }
  ]
}
