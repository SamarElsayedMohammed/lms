{
	"info": {
		"_postman_id": "d6e7f8a9-b1c2-4d3e-8f5a-6b7c8d9e0f1a",
		"name": "LMS - User Dashboard API",
		"description": "API collection for testing the User Dashboard features",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "User Dashboard",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/dashboard",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"dashboard"
					]
				},
				"description": "Get comprehensive data for the student dashboard including stats, recent courses, subscription, and webinars."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api"
		},
		{
			"key": "token",
			"value": "YOUR_TOKEN_HERE"
		}
	]
}
