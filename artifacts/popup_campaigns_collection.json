{
  "info": {
    "name": "Popup Campaigns (Subscription Focus) API",
    "description": "كولكشن لإدارة الحملات المنبثقة الموجهة للاشتراكات في الباقات",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "admin_token", "value": "YOUR_ADMIN_TOKEN", "type": "string" }
  ],
  "item": [
    {
      "name": "🌐 Site (Frontend)",
      "item": [
        {
          "name": "Get Active Popup",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/active-popup", "host": ["{{base_url}}"], "path": ["active-popup"] },
            "description": "يجلب الحملة المنشطة حالياً لعرضها للمستخدم. مبرمجة لترجع تفاصيل الخصم المباشر للباقات."
          },
          "response": [
            {
              "name": "Success Response",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": true,\n  \"message\": \"Active campaign retrieved\",\n  \"data\": {\n    \"campaign\": {\n      \"id\": 1,\n      \"title\": \"وفر 30% الآن\",\n      \"description\": \"على جميع الباقات\",\n      \"image\": \"http://.../uploads/popup_campaigns/img.webp\",\n      \"promo_code\": \"SKILLS026\",\n      \"discount_value\": 30.0,\n      \"discount_type\": \"percentage\",\n      \"cta_url\": \"/subscription-plans\",\n      \"cta_text\": \"اشترك الآن\",\n      \"starts_at\": \"2026-05-01 00:00:00\",\n      \"ends_at\": \"2026-05-30 23:59:59\"\n    }\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "🔐 Admin (Marketing)",
      "item": [
        {
          "name": "List All Popups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/admin/marketing/popups?page=1", "host": ["{{base_url}}"], "path": ["admin", "marketing", "popups"] }
          }
        },
        {
          "name": "Create Popup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "عرض الربيع", "type": "text" },
                { "key": "description", "value": "خصم خاص على باقات الـ Pro", "type": "text" },
                { "key": "image", "type": "file", "src": [] },
                { "key": "promo_code", "value": "PRO2026", "type": "text" },
                { "key": "discount_value", "value": "25", "type": "text" },
                { "key": "discount_type", "value": "percentage", "type": "text" },
                { "key": "cta_url", "value": "/pricing", "type": "text" },
                { "key": "cta_text", "value": "سجل الآن", "type": "text" },
                { "key": "is_active", "value": "1", "type": "text" },
                { "key": "starts_at", "value": "2026-05-02 10:00:00", "type": "text" },
                { "key": "ends_at", "value": "2026-06-02 10:00:00", "type": "text" }
              ]
            },
            "url": { "raw": "{{base_url}}/admin/marketing/popups", "host": ["{{base_url}}"], "path": ["admin", "marketing", "popups"] }
          }
        },
        {
          "name": "Update Popup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "_method", "value": "PUT", "type": "text" },
                { "key": "title", "value": "عنوان جديد", "type": "text" },
                { "key": "is_active", "value": "0", "type": "text" }
              ]
            },
            "url": { "raw": "{{base_url}}/admin/marketing/popups/1", "host": ["{{base_url}}"], "path": ["admin", "marketing", "popups", "1"] }
          }
        },
        {
          "name": "Delete Popup",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/admin/marketing/popups/1", "host": ["{{base_url}}"], "path": ["admin", "marketing", "popups", "1"] }
          }
        }
      ]
    }
  ]
}
